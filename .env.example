# Copy this file to .env and fill in the two values below. .env is git-ignored. Never commit a real token.

# Realm of your Splunk Observability Cloud sandbox org (Settings > your profile shows it). Workshop default: us1
SPLUNK_REALM=us1

# Org access token with the INGEST scope (Settings > Access Tokens > New Token > scope: Ingest)
SPLUNK_ACCESS_TOKEN=REPLACE_ME

# Optional: prefix for the APM environment name. The run script appends -direct or -collector.
DEPLOY_ENV_PREFIX=fsi-workshop

# Optional: set to true to mask sensitive attributes inside the app (Challenge 3)
REDACT_IN_SDK=false
